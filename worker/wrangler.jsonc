{
  "name": "bloknot-groq",
  "main": "src/index.js",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://ekremtezcansaridag.github.io,http://localhost:*,http://127.0.0.1:*"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
