# Paylaşımlı Groq proxy'si (Cloudflare Worker) adresi.
# Boş bırakılırsa uygulama doğrudan Groq bağlantısına düşer ve kullanıcı
# kendi API anahtarını girer.
#
# GitHub Actions'ta bunu kod yerine repo değişkeni olarak tanımla:
# Settings -> Secrets and variables -> Actions -> Variables
# Name: VITE_GROQ_PROXY_URL
# Value: https://bloknot-groq.<hesap>.workers.dev
VITE_GROQ_PROXY_URL=
